+/// Stand-in for the `minidumper` crate. Crash reporting needs `minidumper`,
+/// which depends on `minidump-writer`, and that crate only implements the
+/// minidump CPU contexts of x86, arm and aarch64, so it cannot be built for
+/// loongarch64. Providing the same API as a no-op keeps the rest of this crate
+/// compiling unchanged; see [`init`] for what that means at runtime.
+#[cfg(target_arch = "loongarch64")]
+mod minidumper {
+    use std::{fs::File, path::PathBuf, sync::atomic::AtomicBool, time::Duration};
+
+    #[derive(Debug)]
+    pub enum Error {
+        Unsupported,
+    }
+
+    #[derive(Copy, Clone)]
+    pub enum SocketName<'scope> {
+        Path(&'scope std::path::Path),
+    }
+
+    #[derive(Copy, Clone, PartialEq, Eq)]
+    pub enum LoopAction {
+        Exit,
+        Continue,
+    }
+
+    pub struct MinidumpBinary {
+        pub file: File,
+        pub path: PathBuf,
+        pub contents: Option<Vec<u8>>,
+    }
+
+    pub trait ServerHandler: Send + Sync {
+        fn create_minidump_file(&self) -> Result<(File, PathBuf), std::io::Error>;
+        fn on_minidump_created(&self, result: Result<MinidumpBinary, Error>) -> LoopAction;
+        fn on_message(&self, kind: u32, buffer: Vec<u8>);
+        fn on_client_connected(&self, _num_clients: usize) -> LoopAction {
+            LoopAction::Continue
+        }
+        fn on_client_disconnected(&self, _num_clients: usize) -> LoopAction {
+            LoopAction::Continue
+        }
+    }
+
+    /// Never succeeds, so [`super::crash_server`] gives up before running a
+    /// message loop it could not serve anyway.
+    pub struct Server;
+
+    impl Server {
+        pub fn with_name(_name: SocketName<'_>) -> Result<Self, Error> {
+            Err(Error::Unsupported)
+        }
+
+        pub fn run(
+            self,
+            _handler: Box<dyn ServerHandler>,
+            _shutdown: &AtomicBool,
+            _timeout: Option<Duration>,
+        ) -> Result<(), Error> {
+            Ok(())
+        }
+    }
+
+    /// Drops every message; implements the [`super::CrashServerMessage`] API
+    /// used by this crate without an IPC connection to an actual server.
+    pub struct Client;
+
+    impl Client {
+        pub fn send_message(&self, _kind: u32, _buffer: Vec<u8>) -> Result<(), Error> {
+            Ok(())
+        }
+    }
+}
