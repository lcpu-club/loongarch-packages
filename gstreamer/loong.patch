+    meson test -C build --no-rebuild --print-errorlogs -t $CK_TIMEOUT_MULTIPLIER || echo "Watch out for failed tests!"
 )
 
 _install() {
@@ -1204,7 +1209,7 @@ package_gst-devtools() {
     usr/share/icons/hicolor/*/apps/gst-debug-viewer.*
     usr/share/metainfo/org.freedesktop.GstDebugViewer.appdata.xml
 
-    usr/bin/gst-dots-viewer
+    # usr/bin/gst-dots-viewer
   ); _install
 }
 
