--- a/PKGBUILD
+++ b/PKGBUILD
@@ -34,6 +34,23 @@ prepare() {
   cd $pkgname-$pkgver
 
   patch -Np1 -i "$srcdir"/pin-java-version.patch
+  patch -Np1 -i "$srcdir"/use-system-node.patch
+  patch -Np1 -i "$srcdir"/use-prebuilt-admin-client.patch
+  patch -Np1 -i "$srcdir"/use-loong64-js-deps.patch
+
+  # loong64 has no kiota (.NET tool is not available for this architecture),
+  # so use the prebuilt lib/ shipped in the official npm package instead
+  install -d "$srcdir"/admin-client-npm
+  tar xf "$srcdir"/keycloak-admin-client-$pkgver.tgz -C "$srcdir"/admin-client-npm
+  cp -rT "$srcdir"/admin-client-npm/package/lib js/libs/keycloak-admin-client/prebuilt-lib
+
+  # loong64 has no native @swc/core binding, so set up the @swc/wasm fallback;
+  # keep the swc-wasm version in sync with @swc/core in pnpm-lock.yaml
+  install -d js/loong64-js-deps
+  rm -rf js/loong64-js-deps/wasm
+  tar xf "$srcdir"/swc-wasm-1.15.8.tgz -C js/loong64-js-deps
+  mv js/loong64-js-deps/package js/loong64-js-deps/wasm
+  install -Dm 755 "$srcdir"/fix-js-deps.sh js/loong64-js-deps/fix-js-deps.sh
 }
 
 build() {
@@ -83,4 +100,18 @@ package() {
   install -Dm 644 LICENSE.txt "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.txt"
 }
 
