diff --git a/PKGBUILD b/PKGBUILD
index 16a9957..0fa213b 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -38,6 +38,10 @@ prepare() {
 
 build() {
   cd $_name-$pkgver
+  # loong64: lerna 7 builds its project graph through nx, which has no loong64 build; berry's own workspaces foreach runs the same scripts in topological order
+  export YARN_NPM_REGISTRY_SERVER="${npm_config_registry:-https://registry.npmmirror.com}"
+  unset npm_config_registry YARN_REGISTRY
+  node -e "const f='package.json',j=require('./'+f);j.scripts['build:prod']='jlpm workspaces foreach -pt run build:prod';require('fs').writeFileSync(f,JSON.stringify(j,null,2))"
   python -m build --no-isolation --wheel --skip-dependency-check
 }
 
