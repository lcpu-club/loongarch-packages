--- a/PKGBUILD
+++ b/PKGBUILD
@@ -5,6 +5,7 @@ pkgname=deno
 pkgver=2.9.7
 pkgrel=2
 _rusty_v8_ver=150.4.0
+_libuv_sys_lite_ver=1.48.4
 pkgdesc="A secure runtime for JavaScript and TypeScript"
 arch=('x86_64')
 url="https://deno.com"
@@ -34,6 +35,15 @@ prepare() {
 
   cd ../deno
   echo -e "\n[patch.crates-io]\nv8 = { path = '../rusty_v8' }" >> Cargo.toml
+
+  # libuv-sys-lite only ships prebuilt bindings for x86_64/aarch64 and pins
+  # bindgen 0.70.1, which turns every struct into an opaque blob with clang 20+.
+  mkdir -p ../libuv-sys-lite
+  bsdtar -xf ../libuv-sys-lite-$_libuv_sys_lite_ver.crate \
+    -C ../libuv-sys-lite --strip-components=1
+  sed -i 's/^version = "0.70.1"$/version = "0.72.1"/' ../libuv-sys-lite/Cargo.toml
+  echo "libuv-sys-lite = { path = '../libuv-sys-lite' }" >> Cargo.toml
+
   # Keep the V8 backend while disabling Deno's self-upgrade and vendored zlib-ng.
   sed -i \
     -e '/^v8 = \[/s/"__runtime_defaults", //' \
@@ -97,3 +107,9 @@ package() {
 
   install -Dm644 LICENSE.md -t "$pkgdir"/usr/share/licenses/$pkgname/
 }
+
+source+=("libuv-sys-lite-$_libuv_sys_lite_ver.crate::https://static.crates.io/crates/libuv-sys-lite/libuv-sys-lite-$_libuv_sys_lite_ver.crate")
+sha512sums+=('cfc402f4508e14bf20efd9ff47b113f56546d7ed557fcc744f74630339af7d3dfb771e3d7c70779c33bf97a5c75516067f781f9b87da1763b651926ff60671fa')
+
