+sha512sums[2]='80276dba3e09d333915acde30b2f1ec71cbb370a734fafc2415ac5433dd70adcf1086e980b6509d8588d0fae125a4058aa046082bed9f57cd8789cd9c32b52b5'
diff --git a/compiler-rt-adjust-paths.patch b/compiler-rt-adjust-paths.patch
index 330fff7..2a3131b 100644
--- a/compiler-rt-adjust-paths.patch
+++ b/compiler-rt-adjust-paths.patch
@@ -1,8 +1,6 @@
-diff --git a/build/config/clang/BUILD.gn b/build/config/clang/BUILD.gn
-index d4de2e0cca0..57359c32121 100644
---- a/build/config/clang/BUILD.gn
-+++ b/build/config/clang/BUILD.gn
-@@ -187,16 +187,21 @@ template("clang_lib") {
+--- a/build/config/clang/BUILD.gn	2026-10-18 01:00:12.865268280 +0000
++++ b/build/config/clang/BUILD.gn	2026-10-18 01:00:12.865858300 +0000
+@@ -190,16 +190,20 @@
        } else if (is_linux || is_chromeos) {
          if (current_cpu == "x64") {
            _dir = "x86_64-unknown-linux-gnu"
@@ -17,19 +15,20 @@ index d4de2e0cca0..57359c32121 100644
 +          _suffix = "-aarch64"
          } else if (current_cpu == "loong64") {
            _dir = "loongarch64-unknown-linux-gnu"
-+          _suffix = "-loongarch64"
          } else if (current_cpu == "riscv64") {
            _dir = "riscv64-unknown-linux-gnu"
 +          _suffix = "-riscv64"
          } else if (current_cpu == "ppc64") {
            _dir = "ppc64le-unknown-linux-gnu"
          } else if (current_cpu == "s390x") {
-@@ -231,6 +236,11 @@ template("clang_lib") {
+@@ -234,6 +238,13 @@
          assert(false)  # Unhandled target platform
        }
  
-+      # Bit of a hack to make this find builtins from compiler-rt >= 16
-+      if (is_linux || is_chromeos) {
++      # Bit of a hack to make this find builtins from compiler-rt >= 16.
++      # Arch Linux's loong64 port keeps compiler-rt under the target triple
++      # directory without an arch suffix, so leave that layout alone.
++      if ((is_linux || is_chromeos) && current_cpu != "loong64") {
 +        _dir = "linux"
 +      }
