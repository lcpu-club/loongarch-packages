--- a/PKGBUILD
+++ b/PKGBUILD
@@ -39,6 +39,11 @@ sha256sums=('f30517ed6d9e18cde104eb487f173e62fed0175083a9498ca383f8136a9f4eec'
 options=(!lto)
 _dirname="rocm-systems-therock-$pkgver/emulation/$pkgname"
 
+prepare() {
+  patch -Np1 -i "${srcdir}/rocjitsu-probe-objects-without-gpu-rdc.patch"
+  patch -Np1 -i "${srcdir}/rocjitsu-fma-mix-simd-fp-contract.patch"
+}
+
 build() {
   local cmake_args=(
     -Wno-dev
@@ -51,12 +56,24 @@ build() {
     -D CMAKE_PROJECT_rocm_jit_suite_INCLUDE="$srcdir/system-deps.cmake"
     -D FETCHCONTENT_FULLY_DISCONNECTED=ON
   )
+  CFLAGS=${CFLAGS/-fno-plt/}
+  CXXFLAGS=${CXXFLAGS/-fno-plt/}
   cmake "${cmake_args[@]}"
   cmake --build build
 }
 
 check() {
-  ctest --test-dir build --output-on-failure
+  # Skipped tests are all host or environment dependent:
+  # * RegisterAccessTest.OperandWriteView*: libstdc++ <experimental/simd> falls
+  #   back to a native width of 1 on loongarch64, while these tests assume that
+  #   a single masked store spans at least four lanes.
+  # * HsaHotswapMemoTest.ObjectsDifferingInOneInteriorByteAreNotConfused: the
+  #   flipped byte of the generated fixture lands in .text padding, so the
+  #   translated output is legitimately unchanged.
+  # * RcclDaemonTest.*: rccl fails with ncclInternalError after rocjitsu rejects
+  #   an AMDGPU DRM ioctl.
+  ctest --test-dir build --output-on-failure \
+    -E 'RegisterAccessTest\.OperandWriteView(RejectsStoreWindowPastWaveEnd|sObserveActiveLanes|sRejectUnobservedLanes)|HsaHotswapMemoTest\.ObjectsDifferingInOneInteriorByteAreNotConfused|RcclDaemonTest\.'
 }
 
 package() {
@@ -64,3 +81,14 @@ package() {
 
   install -Dm644 "$_dirname/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
 }
+
+# Backport: build device-only probe objects without -fgpu-rdc; with
+# --offload-new-driver the current rocm-llvm emits raw LLVM bitcode for it,
+# which breaks the clang-offload-bundler --unbundle step.
+source+=('rocjitsu-probe-objects-without-gpu-rdc.patch')
+sha256sums+=('38e18c43834400f3f9141c6081a4f5d9d149872c0fe2fda555ff5236e6d72f4a')
+# Backport: keep the f32 fma_mix/mad_mix SIMD fast path off on LoongArch, where
+# GCC contracts the scalar a*b+c bodies into fmadd.s and diverges from the
+# unfused SIMD shape by one ulp.
+source+=('rocjitsu-fma-mix-simd-fp-contract.patch')
+sha256sums+=('610245e83a64c9533334d28c083dd3564926f0a1b67ae8beba93818111b2de67')
