 esac
 
 _jvmdir=/usr/lib/jvm/java-${_majorver}-openjdk
@@ -455,4 +456,6 @@ package_openjdk21-doc() {
   ln -s ${pkgbase} "${pkgdir}/usr/share/licenses/${pkgname}"
 }
 
+source[0]="https://github.com/loongson/jdk${_majorver}u/archive/${_git_tag}.tar.gz"
