   export CUDAFLAGS="--threads 8"
@@ -132,6 +126,7 @@ build() {
     -DGINKGO_BUILD_HIP=OFF \
     -DGINKGO_BUILD_SYCL=OFF
   cmake --build build-cuda
+COMMENT_SEPARATOR
 
   # -hip package
   # LTO does not work with HIP
@@ -151,6 +146,7 @@ build() {
     -DGINKGO_BUILD_SYCL=OFF
   cmake --build build-hip
 
+  : <<COMMENT_SEPARATOR
   # -sycl package
   # With debug symbols, memory consumption of icpx blows up
   export CXXFLAGS="${CXXFLAGS/-g/}"
@@ -169,6 +165,7 @@ build() {
     -DGINKGO_BUILD_BENCHMARKS=OFF \
     -DGINKGO_BUILD_EXAMPLES=OFF
   cmake --build build-sycl
+COMMENT_SEPARATOR
 }
 
 check() {
@@ -270,4 +267,6 @@ package_ginkgo-hpc-sycl() {
   _package -sycl
 }
 
+pkgname=($(printf "%s\n" "${pkgname[@]}" | grep -Ev '^(ginkgo-hpc-cuda|ginkgo-hpc-sycl)$'))
