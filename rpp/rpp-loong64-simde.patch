--- a/api/rppdefs.h
+++ b/api/rppdefs.h
@@ -50,10 +50,34 @@
 
 #if _WIN32
 #include <intrin.h>
-#else
+#elif defined(__x86_64__) || defined(__i386__)
 #include <x86intrin.h>
 #include <smmintrin.h>
 #include <immintrin.h>
+#else
+/* Non-x86 hosts (e.g. loongarch64): the CPU kernels are written against the
+   x86 SSE/AVX/AVX2/FMA/F16C intrinsics, so emulate them with SIMDe. */
+#ifndef SIMDE_ENABLE_NATIVE_ALIASES
+#define SIMDE_ENABLE_NATIVE_ALIASES
+#endif
+#ifndef SIMDE_NO_NATIVE
+#define SIMDE_NO_NATIVE
+#endif
+#include <stdlib.h>
+typedef int __v4si __attribute__((__vector_size__(16)));
+typedef long long __v2di __attribute__((__vector_size__(16)));
+static inline void *_mm_malloc(size_t size, size_t align)
+{
+    void *ptr = NULL;
+    return (posix_memalign(&ptr, align, size) == 0) ? ptr : NULL;
+}
+static inline void _mm_free(void *ptr) { free(ptr); }
+#ifndef _MM_FROUND_NO_EXC
+#define _MM_FROUND_NO_EXC 0x08
+#endif
+#include <simde/x86/avx2.h>
+#include <simde/x86/fma.h>
+#include <simde/x86/f16c.h>
 #endif
 #include<vector>
 
