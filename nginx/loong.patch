--- a/PKGBUILD
+++ b/PKGBUILD
@@ -74,6 +74,15 @@ prepare() {
   # Fix ssl_certificate_compression test: loop only checked first algorithm
   sed '/\$has_zlib = 1 if \$algo == 1;/{n;/^\t\t\t\tlast;/d}' -i nginx-tests/ssl_certificate_compression.t
 
+  # Fix ssl_stapling.t: read the response so that nginx has written it before the client closes
+  # the connection, otherwise a harmless "SSL_write() failed" crit is logged and fails the test
+  sed -i 's/^\treturn \$s unless \$s;$/\treturn $s unless $s;\n\tmy $buf;\n\t1 while $s->sysread($buf, 4096);/' nginx-tests/ssl_stapling.t
+  grep -q 'while \$s->sysread' nginx-tests/ssl_stapling.t
+
+  # loongarch64: use 64-byte cache line (fixes server_names_hash_bucket_size
+  # default of 32, which breaks ssl_store_keys.t and real-world long server names)
+  patch -d $pkgbase -Np1 -i "$srcdir"/nginx-loongarch-cacheline.patch
+
   # OpenSSL 4.1 no longer falls back to the subject CN for hostname checks; give the CN-only test
   # certificates a matching DNS SAN.
   cd nginx-tests
@@ -324,3 +333,6 @@ package_nginx-mod-xslt() {
   backup=(etc/nginx/modules.d/20-xslt.conf)
   _package_module xslt
 }
+
+source+=('nginx-loongarch-cacheline.patch')
+sha512sums+=('af0a50556c99bd4d4b249d33fed83ba976dfc94275ff0bc5fbf8248d10feb9ade277e02b8f1e4aad36f8b27f18073503cc4ba8eeb070afaf11dc1adde370d2e8')
