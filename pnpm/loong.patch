--- a/PKGBUILD
+++ b/PKGBUILD
@@ -38,8 +38,25 @@ prepare() {
   fi
 
   cd $pkgname/${pkgname}11/$pkgname
-  pnpm install --frozen-lockfile
 
+  # Loong64: the artifacts/ packages ship prebuilt binaries for other
+  # architectures only
+  rm -r artifacts
+
+  # Loong64: neither the package manager pinned in the workspace manifest
+  # (packageManager/devEngines) nor the Node.js runtime is published for
+  # loong64, so drop them and use the system node and tsc instead
+  jq 'del(.packageManager,
+          .devEngines,
+          .devDependencies["@typescript/native-preview"])' \
+    ../../package.json > ../../package.json.tmp && mv ../../package.json.tmp ../../package.json
+  sed -i 's/tsgo/tsc/g' ../../package.json
+  sed -i 's/pnx node@runtime:[^ ]*/node/g' ../../package.json
+  sed -i 's/tsgo/tsc/g' package.json
+  sed -i 's/pnx node@runtime:[^ ]* bundle.ts/node bundle.ts/g' package.json
+  sed -i 's/tsgo/tsc/g' ../worker/package.json
+
+  pnpm install
 }
 
 build() {
@@ -66,3 +83,5 @@ package() {
   cd dist
   cp -r $pkgname.mjs pnpmrc templates worker.js "$pkgdir"/$mod_dir/dist
 }
+
+makedepends+=('jq')
