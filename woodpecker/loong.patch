--- a/PKGBUILD
+++ b/PKGBUILD
@@ -49,6 +49,13 @@ b2sums=('aef6afdc154fcdf92bda12652542c3888bf09730d064269596979c02a9d46299230e052
 prepare() {
   cd "$pkgbase"
 
+  # loong64: web UI built with vite 8 -> rolldown, which ships no loong64 native
+  # binding and its wasm32-wasi fallback deadlocks on this project
+  # (https://github.com/rolldown/rolldown/issues/10119). Pin vite 7 (esbuild +
+  # rollup, both available on loong64) and use wasm fallbacks for tailwindcss
+  # oxide and lightningcss. See woodpecker-web-loong64.patch for details.
+  patch -Np1 -i "${srcdir}/woodpecker-web-loong64.patch"
+
   # create directory for build output
   mkdir build
 
@@ -131,3 +138,8 @@ package_woodpecker-cli() {
   # binary
   install -vDm755 build/cli "$pkgdir/usr/bin/woodpecker"
 }
+
+# --- loong64 patches (see prepare) ---
+source+=("woodpecker-web-loong64.patch")
