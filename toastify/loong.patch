 prepare() {
   cd $pkgname
   cargo fetch --locked --target "$(rustc --print host-tuple)"
+
+  # nix 0.23 (pinned via notify-rust) lacks loongarch64 in the ioctl protocol list
+  local nix_dir
+  nix_dir=$(find "${CARGO_HOME:-$HOME/.cargo}/registry/src" -maxdepth 2 -type d -name 'nix-0.23.*' | head -n1)
+  sed -i 's/^\( *\)target_arch = "riscv64"))\]$/\1target_arch = "riscv64",\n\1target_arch = "loongarch64"))]/' \
+    "$nix_dir/src/sys/ioctl/linux.rs"
 }
 
