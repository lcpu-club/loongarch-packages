--- a/PKGBUILD
+++ b/PKGBUILD
@@ -37,6 +37,19 @@ b2sums=('d5f8c3b34f86b9cf8bb58ff9af5d9301a83ab120385da950b7baaa45b3f464dfe113aa5
 prepare() {
   cd ${pkgname}-${pkgver}
   cargo fetch --locked --target "$(rustc --print host-tuple)"
+
+  local registry="${CARGO_HOME:-$HOME/.cargo}/registry/src"
+
+  # loongarch64: nix 0.26.4 (via cf-mach -> webrtc -> webrtc-util) does not
+  # list loongarch64 among the architectures using the generic ioctl encoding,
+  # so its unconditional `pub use self::consts::*` fails to resolve.
+  patch -Np1 -d "$registry"/*/nix-0.26.4 -i "$srcdir/0001-loongarch64-nix-ioctl.patch"
+
+  # loongarch64: BoringSSL, vendored by boring-sys (via cf-mach), supports
+  # neither LoongArch nor assembly for it. Build it as a generic 64-bit little
+  # endian target without assembly, the same way the Dart SDK does.
+  patch -Np1 -d "$registry"/*/boring-sys-* -i "$srcdir/0002-loongarch64-boringssl-target.patch"
+  patch -Np1 -d "$registry"/*/boring-sys-* -i "$srcdir/0003-loongarch64-boringssl-no-asm.patch"
 }
 
 
@@ -63,3 +76,12 @@ package() {
     install -Dm644 -t "${pkgdir}"/usr/share/doc/${pkgname}/examples/ ${example}
   done
 }
+
+# loongarch64: patches for the Rust dependencies of the speedtest block
+# (cf-mach -> webrtc -> webrtc-util -> nix 0.26.4, cf-mach -> boring-sys).
+source+=('0001-loongarch64-nix-ioctl.patch'
