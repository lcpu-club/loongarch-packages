+        return;
+    case Type::Char:
+    case Type::Int8:
+        *static_cast<ffi_sarg*>(result) = static_cast<int8_t>(slot);
+        return;
+    case Type::Int16:
+        *static_cast<ffi_sarg*>(result) = static_cast<int16_t>(slot);
+        return;
+    case Type::Int32:
+        *static_cast<ffi_sarg*>(result) = static_cast<int32_t>(slot);
+        return;
+    case Type::Uint8:
+        *static_cast<ffi_arg*>(result) = static_cast<uint8_t>(slot);
+        return;
+    case Type::Bool:
+        *static_cast<ffi_arg*>(result) = slot ? 1 : 0;
+        return;
+    case Type::Uint16:
+        *static_cast<ffi_arg*>(result) = static_cast<uint16_t>(slot);
+        return;
+    case Type::Uint32:
+        *static_cast<ffi_arg*>(result) = static_cast<uint32_t>(slot);
+        return;
+    case Type::Float: {
+        uint32_t bits = static_cast<uint32_t>(slot);
+        memcpy(result, &bits, sizeof(bits));
+        return;
+    }
+    default:
+        memcpy(result, &slot, sizeof(slot));
+        return;
+    }
+}
+
+void libffiCallbackHandler(ffi_cif*, void* result, void** arguments, void* userData)
+{
+    JSFFICallback* callback = static_cast<JSFFICallback*>(userData);
+    Signature& signature = callback->signature();
+    const unsigned argumentCount = signature.argumentCount();
+    uint64_t slots[Signature::maxArguments + 1];
+    for (unsigned i = 0; i < argumentCount; ++i)
+        slots[i] = slotFromArgument(signature.argumentType(i), arguments[i]);
+    slots[argumentCount] = 0;
+    if (callback->isThreadsafe())
+        ffiCallbackDispatchThreadsafe(callback, slots);
+    else
+        ffiCallbackDispatch(callback, slots);
+    storeResult(signature.returnType(), slots[argumentCount], result);
+}
