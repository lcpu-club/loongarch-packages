+void* createLibffiCallback(JSFFICallback& callback, void** entrypoint)
+{
+    Signature& signature = callback.signature();
+    const unsigned argumentCount = signature.argumentCount();
+    RELEASE_ASSERT(argumentCount <= Signature::maxArguments);
+    auto entry = makeUnique<LibffiCallback>();
+    for (unsigned i = 0; i < argumentCount; ++i)
+        entry->argumentTypes[i] = libffiType(signature.argumentType(i));
+    if (ffi_prep_cif(&entry->cif, FFI_DEFAULT_ABI, argumentCount, libffiType(signature.returnType()), entry->argumentTypes) != FFI_OK)
+        return nullptr;
+    void* code = nullptr;
+    entry->closure = static_cast<ffi_closure*>(ffi_closure_alloc(sizeof(ffi_closure), &code));
+    if (!entry->closure)
+        return nullptr;
+    if (ffi_prep_closure_loc(entry->closure, &entry->cif, libffiCallbackHandler, &callback, code) != FFI_OK) {
+        ffi_closure_free(entry->closure);
+        return nullptr;
+    }
+    *entrypoint = code;
+    return entry.release();
+}
+
+void destroyLibffiCallback(void* handle)
+{
+    auto* entry = static_cast<LibffiCallback*>(handle);
+    if (!entry)
+        return;
+    ffi_closure_free(entry->closure);
+    delete entry;
+}
