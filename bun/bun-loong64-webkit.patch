+// The slot encoding of generateCallbackThunk's emitStoreIncomingArgument*:
+// integers extended to 64 bits by their signedness, bool as 0/1, float in the
+// low 32 bits with the high half zero, everything else the raw 64 bits.
+uint64_t slotFromArgument(Type type, const void* value)
+{
+    switch (type) {
+    case Type::Char:
+    case Type::Int8:
+        return static_cast<uint64_t>(static_cast<int64_t>(*static_cast<const int8_t*>(value)));
+    case Type::Uint8:
+        return *static_cast<const uint8_t*>(value);
+    case Type::Bool:
+        return *static_cast<const uint8_t*>(value) ? 1 : 0;
+    case Type::Int16:
+        return static_cast<uint64_t>(static_cast<int64_t>(*static_cast<const int16_t*>(value)));
+    case Type::Uint16:
+        return *static_cast<const uint16_t*>(value);
+    case Type::Int32:
+        return static_cast<uint64_t>(static_cast<int64_t>(*static_cast<const int32_t*>(value)));
+    case Type::Uint32:
+        return *static_cast<const uint32_t*>(value);
+    case Type::Float: {
+        uint32_t bits;
+        memcpy(&bits, value, sizeof(bits));
+        return bits;
+    }
+    default: {
+        uint64_t bits;
+        memcpy(&bits, value, sizeof(bits));
+        return bits;
+    }
+    }
