+
+UV_EXTERN void uv_rwlock_rdunlock(uv_rwlock_t* rwlock)
+{
+    if (pthread_rwlock_unlock(rwlock))
+        abort();
+}
+
+UV_EXTERN int uv_rwlock_tryrdlock(uv_rwlock_t* rwlock)
+{
+    int err = pthread_rwlock_tryrdlock(rwlock);
+    if (err == EBUSY || err == EAGAIN)
+        return UV_EBUSY;
