+    switch (clock_id) {
+    case UV_CLOCK_MONOTONIC:
+        clock = CLOCK_MONOTONIC;
+        break;
+    case UV_CLOCK_REALTIME:
+        clock = CLOCK_REALTIME;
+        break;
+    default:
+        return UV_EINVAL;
+    }
