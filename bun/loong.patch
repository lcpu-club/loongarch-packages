diff --git a/PKGBUILD b/PKGBUILD
index 7b9becd..52fc83e 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -55,6 +55,12 @@ prepare() {
   # to be stored for numbers > INT32_MAX (https://github.com/oven-sh/bun/issues/28607)
   patch -Np1 -d $pkgname-WebKit < $pkgname-webkit-typed-array-int32-conversion.patch
 
+  if [[ "$CARCH" == loong64 ]]; then
+    patch -Np1 -d $pkgname-WebKit < $pkgname-loong64-webkit.patch
+    patch -Np1 -d $pkgname < $pkgname-loong64-src.patch
+    patch -Np1 -d $pkgname < $pkgname-loong64.patch
+  fi
+
   cd $pkgname
 
   grep -q "WEBKIT_VERSION = \"$_webkitver\"" scripts/build/deps/webkit.ts \
@@ -77,6 +83,11 @@ prepare() {
 build() {
   cd $pkgname
 
+  if [[ "$CARCH" == loong64 ]]; then
+    mkdir -p node_modules/.bin
+    ln -sf /usr/bin/esbuild node_modules/.bin/esbuild
+  fi
+
   export PATH="/usr/lib/llvm21/bin:$PATH"
   case "$CARCH" in
     x86_64)  _bundir="bun-linux-x64" ;;
@@ -95,7 +106,12 @@ build() {
     bun_options+=(--baseline=on)
   fi
 
-  bun scripts/build.ts "${bun_options[@]}"
+  if [[ "$CARCH" == loong64 ]]; then
+    # bootstrap bun turns ninja's log pipe nonblocking, losing cmake output
+    node --experimental-strip-types scripts/build.ts "${bun_options[@]}"
+  else
+    bun scripts/build.ts "${bun_options[@]}"
+  fi
 }
 
 check() {
@@ -116,3 +132,22 @@ package() {
   install -vDm644 completions/bun.fish "$pkgdir/usr/share/fish/vendor_completions.d/bun.fish"
   install -vDm644 completions/bun.zsh "$pkgdir/usr/share/zsh/site-functions/_bun"
 }
+
+# bun:ffi on loong64: JavaScriptCore calls native functions through libffi
+# (no JIT invoke thunks), and cc() uses TinyCC's LoongArch64 backend.
+depends_loong64=(
+  libffi
+)
+makedepends_loong64=(
+  bun
+  nodejs
+  esbuild
+)
+source_loong64=(
+  "$pkgname-loong64.patch"
+  "$pkgname-loong64-src.patch"
+  "$pkgname-loong64-webkit.patch"
+)
+b2sums_loong64=('d9b2431ee519c9a58000207917f1407cc701817670bf98aea9e6c54302390bb275478542c0a4bdecc7a17ba4d346280e7f1c73e872535261fee2af0db7ea73c6'
+                '4dc9767b9575e385952f676f59f5a59b2681c7e401376522f3250d70be96ae82bef3525fe56f1f1b7c27e779f2df7c5f17865c73d70209ea4b3c8aba09593429'
+                'fe9df68a0e761a2bdec98ddd11da83b0d787bde84bc0ed5ca671920836561b340e8ff387c50010969e822f4746e7aa0bbc1949b25a7d0cf837e37eb2c80fc498')
