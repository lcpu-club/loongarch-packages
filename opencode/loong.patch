diff --git a/PKGBUILD b/PKGBUILD
index 83ccb81..0314108 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -36,11 +36,36 @@ b2sums=('1288de1314f02a21c06406bf2f4530b849acc056431c6d73c7ce092d456be4f25ff762b
 prepare() {
   cd $pkgname
   sed -i 's|"packageManager": "bun@1.4.2"|"packageManager": "bun@1.4.0"|' package.json
-  bun install --frozen-lockfile --ignore-scripts
+  patch -Np1 -i ../wasm-css.patch
+  patch -Np1 -i ../loong64-target.patch
+  # Bun on loong64 has no WebAssembly; fall back to the portable shell scanner.
+  patch -Np1 -i ../portable-shell-scanner.patch
+  cp ../fix-oxide-worker-exit.patch ../opentui-loong64.patch patches/
+  # The lockfile records LoongArch optional dependencies with an unsupported CPU.
+  sed -i '/linux-loong64/s/"cpu": "none"/"cpu": "loong64"/' bun.lock
+  # Install Oxide's threaded WASM fallback on the host architecture.
+  sed -i '/"@tailwindcss\/oxide-wasm32-wasi":/s/"cpu": "none"/"cpu": "loong64"/' bun.lock
+  bun install --ignore-scripts
+
+  cd "$srcdir/opentui-0.5.10/packages/native"
+  bash scripts/prepare-zig-deps.sh
 }
 
 build() {
-  cd $pkgname/packages/cli
+  # Parcel does not publish a LoongArch watcher addon; retain native inotify support.
+  cd "$srcdir/$pkgname/packages/core/node_modules/@parcel/watcher"
+  node-gyp rebuild --nodedir=/usr
+
+  # Koffi's prebuilt LoongArch addon replaces Bun's JIT-dependent FFI trampolines.
+  tar -xzf "$srcdir/koffi-linux-loong64-3.2.1.tgz" -C "$srcdir"
+  cp "$srcdir/package/linux_loong64/koffi.node" \
+    "$srcdir/$pkgname/packages/cli/node_modules/@opentui/core/"
+
+  # OpenTUI 0.5.10 does not publish a LoongArch renderer; build it with Zig.
+  cd "$srcdir/opentui-0.5.10/packages/native"
+  zig build -Doptimize=ReleaseFast -Dlibrary-target=loongarch64-linux-gnu.2.36
+
+  cd "$srcdir/$pkgname/packages/cli"
   OPENCODE_VERSION=$pkgver bun run ./script/build.ts --single --baseline --skip-install
 }
 
@@ -61,9 +86,12 @@ package() {
   cd $pkgname
   case $CARCH in
   aarch64) dir=cli-linux-arm64 ;;
+  loong64) dir=cli-linux-loong64 ;;
   x86_64) dir=cli-linux-x64-baseline ;;
   esac
   install -vDm755 -t "$pkgdir/usr/bin" "packages/cli/dist/$dir/bin/opencode"
+  install -vDm755 -t "$pkgdir/usr/lib/opencode" \
+    "$srcdir/opentui-0.5.10/packages/native/lib/loongarch64-linux-gnu.2.36/libopentui.so"
 
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 
@@ -72,3 +100,25 @@ package() {
   "$pkgdir/usr/bin/opencode" --completions zsh \
     | install -vDm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_opencode"
 }
