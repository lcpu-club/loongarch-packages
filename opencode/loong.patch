--- a/PKGBUILD
+++ b/PKGBUILD
@@ -36,18 +36,42 @@ b2sums=('7cea1cbf241901c6ad4b5a3880d1df3533cb526f783af5060b3d54fbe39ba947d0c68ae
 
 prepare() {
   cd $pkgbase
-  bun install --frozen-lockfile --ignore-scripts
+  patch -Np1 -i ../wasm-css.patch
+  patch -Np1 -i ../loong64-target.patch
+  cp ../fix-oxide-worker-exit.patch ../opentui-loong64.patch ../builder-util-loong64.patch patches/
+  # The lockfile records LoongArch optional dependencies with an unsupported CPU.
+  sed -i "/linux-loong64/s/\"cpu\": \"none\"/\"cpu\": \"loong64\"/" bun.lock
+  # Install Oxide's threaded WASM fallback on the host architecture.
+  sed -i "/\"@tailwindcss\/oxide-wasm32-wasi\":/s/\"cpu\": \"none\"/\"cpu\": \"loong64\"/" bun.lock
+  bun install --ignore-scripts
 
   # resourcesPath points to the system electron dir, use our install dir instead
   grep -rl 'process\.resourcesPath' packages/desktop/src/main \
     | xargs sed -i 's|process\.resourcesPath|"/usr/lib/opencode-desktop"|g'
+
+  cd "$srcdir/opentui-0.8.0/packages/native"
+  bash scripts/prepare-zig-deps.sh
 }
 
 build() {
+  # Parcel does not publish a LoongArch watcher addon; retain native inotify support.
+  cd "$srcdir/$pkgbase/packages/core/node_modules/@parcel/watcher"
+  node-gyp rebuild --nodedir=/usr
+
+  # Koffi's prebuilt LoongArch addon replaces Bun's JIT-dependent FFI trampolines.
+  tar -xzf "$srcdir/koffi-linux-loong64-3.2.1.tgz" -C "$srcdir"
+  cp "$srcdir/package/linux_loong64/koffi.node" \
+    "$srcdir/$pkgbase/packages/cli/node_modules/@opentui/core/"
+
+  # OpenTUI 0.8.0 does not publish a LoongArch renderer; build it with Zig.
+  cd "$srcdir/opentui-0.8.0/packages/native"
+  "$srcdir/zig-loongarch64-linux-0.16.0/zig" build -Doptimize=ReleaseFast -Dlibrary-target=loongarch64-linux-gnu.2.36
+
   # build CLI
   cd "$srcdir/$pkgbase/packages/cli"
   case $CARCH in
     aarch64) target=linux-arm64 ;;
+    loong64) target=linux-loong64 ;;
     x86_64) target=linux-x64-baseline ;;
   esac
   OPENCODE_TARGET=$target OPENCODE_VERSION=$pkgver bun run ./script/build.ts --skip-install
@@ -96,9 +120,13 @@ package_opencode() {
   cd $pkgbase
   case $CARCH in
     aarch64) target=linux-arm64 ;;
+    loong64) target=linux-loong64 ;;
     x86_64) target=linux-x64-baseline ;;
   esac
   install -vDm755 -t "$pkgdir/usr/bin" "packages/cli/dist/cli-$target/bin/opencode"
+  # The CLI loads the OpenTUI renderer from this path on loong64.
+  install -vDm755 -t "$pkgdir/usr/lib/opencode" \
+    "$srcdir/opentui-0.8.0/packages/native/lib/loongarch64-linux-gnu.2.36/libopentui.so"
 
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
 
@@ -126,7 +154,10 @@ package_opencode-desktop() {
   # linux-<arch>-unpacked elsewhere (e.g. linux-arm64-unpacked)
   local resources=(dist/linux*-unpacked/resources)
   install -vDm644 -t "$pkgdir/usr/lib/$pkgname" $resources/app.asar $resources/opencode-cli.version
-  cp -vr --no-preserve=ownership $resources/app.asar.unpacked "$pkgdir/usr/lib/$pkgname/"
+  # loong64 has no native Node modules to unpack, so electron-builder skips this dir.
+  if [[ -d $resources/app.asar.unpacked ]]; then
+    cp -vr --no-preserve=ownership $resources/app.asar.unpacked "$pkgdir/usr/lib/$pkgname/"
+  fi
   install -vDm644 -t "$pkgdir/usr/lib/$pkgname/icons" resources/icons/icon.png
   ln -vs /usr/bin/opencode "$pkgdir/usr/lib/$pkgname/opencode-cli"
 
@@ -146,3 +177,29 @@ package_opencode-desktop() {
 
   install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" ../../LICENSE
 }
