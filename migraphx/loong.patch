--- a/PKGBUILD
+++ b/PKGBUILD
@@ -49,6 +49,8 @@ prepare() {
   # Windows version resource
   sed -i '/^include(ROCMSetupVersion)$/a function(rocm_add_version_resource)\nendfunction()' \
     CMakeLists.txt
+  cd "$srcdir"/$pkgname-rocmlir
+  patch -p1 -i "$srcdir"/fix-logf128-type-mismatch-on-loongarc.patch
 }
 
 build() {
@@ -99,3 +101,8 @@ package() {
   install -Dm644 "$pkgname-rocmlir"/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rocMLIR"
   install -Dm644 "$pkgname-rocmlir"/external/llvm-project/LICENSE.TXT "$pkgdir/usr/share/licenses/$pkgname/LICENSE.llvm-project"
 }
+
+# loong64: rocMLIR bundles LLVM, whose ConstantFolding.cpp passes logf128 to
+# ConstantFoldFP128; logf128 takes _Float128 while LLVM float128 is __float128.
+source+=("fix-logf128-type-mismatch-on-loongarc.patch")
+sha256sums+=('48cba9e17aed739cf3c007f16330a67d157cf39a3fa750f2e82aa6d0a039ef2e')
