diff --git a/PKGBUILD b/PKGBUILD
index 113a74a..ef685c6 100644
--- a/PKGBUILD
+++ b/PKGBUILD
@@ -25,6 +25,10 @@ build() {
         export CGO_CXXFLAGS="${CXXFLAGS}"
         export CGO_LDFLAGS="${LDFLAGS}"
         export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
+        # loong64: old gopsutil snapshot has no loong64 utmp; switch to /v3
+        sed -i 's|"github.com/shirou/gopsutil/|"github.com/shirou/gopsutil/v3/|' gopsuinfo.go
+        go mod edit -require=github.com/shirou/gopsutil/v3@v3.24.5
+        go mod tidy
         go build -ldflags="-linkmode=external -buildid=''" -o "build/${pkgname}" *.go
 }
 
@@ -36,3 +40,5 @@ package() {
 	install -Dm 644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
 	install -Dm 644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
 }
+
+makedepends+=(git)
