   export RUSTONIG_DYNAMIC_LIBONIG=1
   export ZSTD_SYS_USE_PKG_CONFIG=1
   # The CLI and voice helper require matching build identities.
@@ -135,4 +137,12 @@ package_openai-codex-voice() {
     "$pkgdir/usr/lib/openai-codex/codex-resources/voice/bin/codex-voice-host"
 }
 
